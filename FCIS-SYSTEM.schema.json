{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fountain-Coach/.github/blob/main/FCIS-SYSTEM.schema.json",
  "title": "FCIS prerequisite-free whole-system composition",
  "description": "Structural source gate; the semantic source/digest and operation/ref inventory gates remain separate independent checks.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "kind",
    "schemaVersion",
    "compositionId",
    "status",
    "owner",
    "designPrinciple",
    "scope",
    "specificationSources",
    "specificationPrecedence",
    "moduleGraph",
    "frontend",
    "apis",
    "initialization",
    "persistentStoreFormat",
    "secretStoreFormat",
    "persistence",
    "custody",
    "authorityAndIdentity",
    "ownerAndTenancy",
    "capabilitySystem",
    "skillAndScenarioSystem",
    "migration",
    "generation",
    "acceptance",
    "specificationClosure",
    "sourcePinPolicy",
    "coverageBaseline",
    "knownSpecificationLimitations"
  ],
  "properties": {
    "kind": {
      "const": "fountaincoach.fcis.system.composition"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "NORMATIVE_SPECIFICATION_CANDIDATE__NOT_GENERATED",
        "SPEC_VALIDATED__NOT_GENERATED",
        "GENERATION_INCOMPLETE",
        "GENERATED__NOT_TESTED",
        "SOURCE_TESTED__NOT_RELEASED",
        "RELEASED__NOT_LIVE_ACCEPTED",
        "LIVE_ACCEPTED"
      ]
    },
    "compositionId": {
      "type": "string",
      "minLength": 4
    },
    "owner": {
      "const": "Fountain Coach"
    },
    "documentSchema": {
      "const": "FCIS-SYSTEM.schema.json"
    },
    "designPrinciple": {
      "type": "object",
      "required": [
        "name",
        "rule",
        "defaultProfile",
        "externalProviderPolicy",
        "securityBoundary"
      ],
      "properties": {
        "name": {
          "const": "Voraussetzungslos"
        },
        "rule": {
          "type": "string",
          "minLength": 30
        },
        "defaultProfile": {
          "const": "fresh-install"
        },
        "externalProviderPolicy": {
          "type": "string"
        },
        "securityBoundary": {
          "type": "string"
        },
        "resourcesAllowedForInstall": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "fresh-install",
              "adopt-existing"
            ]
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "goal",
        "included",
        "defaultInstallation",
        "productionHost",
        "currentFountainCoachMigration"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 50
        },
        "included": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "defaultInstallation": {
          "type": "string",
          "minLength": 10
        },
        "productionHost": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "specificationSources": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "$ref": "#/$defs/gitSource"
      }
    },
    "sourcePinPolicy": {
      "type": "object",
      "required": [
        "immutable",
        "httpContractVersion",
        "apiBlobSha",
        "stackBlobSha"
      ],
      "properties": {
        "immutable": {
          "type": "string"
        },
        "httpContractVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "apiBlobSha": {
          "$ref": "#/$defs/sha"
        },
        "stackBlobSha": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "moduleGraph": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "id",
          "language",
          "owns"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 5
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "owns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": [
        "origin",
        "managementPath",
        "assets",
        "authentication",
        "apiBindings",
        "selfHosting",
        "sourceBindingReconciliation"
      ],
      "properties": {
        "managementPath": {
          "const": "/manage/"
        },
        "assets": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "selfHosting": {
          "type": "object",
          "required": [
            "default",
            "urlBinding",
            "sourceCompatibility",
            "login"
          ]
        },
        "sourceBindingReconciliation": {
          "type": "object",
          "required": [
            "detectedPriorAssumptions",
            "requiredTransformations"
          ],
          "properties": {
            "requiredTransformations": {
              "type": "array",
              "minItems": 8,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "effect"
                ]
              }
            }
          }
        }
      }
    },
    "apis": {
      "type": "object",
      "required": [
        "fcis",
        "fountainstore",
        "secretstore"
      ],
      "properties": {
        "fcis": {
          "$ref": "#/$defs/httpApi"
        },
        "fountainstore": {
          "$ref": "#/$defs/httpApi"
        },
        "secretstore": {
          "$ref": "#/$defs/httpApi"
        }
      }
    },
    "initialization": {
      "type": "object",
      "required": [
        "binary",
        "requiredCommands",
        "fileLayout",
        "atomicInit",
        "initialState",
        "setupTicket",
        "stateMachine",
        "selfHostedFrontend",
        "externalDependenciesForFirstStart"
      ],
      "properties": {
        "binary": {
          "const": "fcis"
        },
        "requiredCommands": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": [
              "name",
              "effect"
            ]
          }
        },
        "initialState": {
          "type": "object",
          "required": [
            "ownerCount",
            "credentialCount",
            "grants",
            "admittedRemoteHosts",
            "phase"
          ],
          "properties": {
            "phase": {
              "const": "UNCLAIMED"
            },
            "ownerCount": {
              "const": 0
            },
            "credentialCount": {
              "const": 0
            },
            "grants": {
              "const": 0
            },
            "admittedRemoteHosts": {
              "const": 0
            }
          }
        },
        "setupTicket": {
          "type": "object",
          "required": [
            "algorithm",
            "storage",
            "expiresAfterSeconds",
            "singleUse",
            "consumption",
            "concurrentClaim"
          ],
          "properties": {
            "expiresAfterSeconds": {
              "type": "integer",
              "minimum": 30,
              "maximum": 3600
            },
            "singleUse": {
              "const": true
            }
          }
        },
        "stateMachine": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "required": [
              "state",
              "action",
              "next",
              "guard"
            ]
          }
        },
        "externalDependenciesForFirstStart": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "persistentStoreFormat": {
      "type": "object",
      "required": [
        "id",
        "scope",
        "records",
        "wal",
        "snapshot",
        "manifest",
        "transactions",
        "recovery"
      ],
      "properties": {
        "id": {
          "const": "fountainstore.go.v1"
        },
        "wal": {
          "type": "object",
          "required": [
            "file",
            "frame",
            "commit",
            "replay",
            "rotation"
          ]
        },
        "snapshot": {
          "type": "object",
          "required": [
            "format",
            "commit",
            "hash",
            "corruption"
          ]
        },
        "manifest": {
          "type": "object",
          "required": [
            "file",
            "fields",
            "atomicReplace",
            "backup"
          ]
        },
        "transactions": {
          "type": "object",
          "required": [
            "isolation",
            "cas",
            "refusal"
          ]
        }
      }
    },
    "secretStoreFormat": {
      "type": "object",
      "required": [
        "id",
        "paths",
        "rootKey",
        "envelope",
        "operations",
        "issuerSigning",
        "providerInterface",
        "security"
      ],
      "properties": {
        "id": {
          "const": "secretstore.go.v1"
        },
        "rootKey": {
          "type": "object",
          "required": [
            "generation",
            "storage",
            "threatModel"
          ]
        },
        "envelope": {
          "type": "object",
          "required": [
            "version",
            "algorithm",
            "nonceBytes",
            "tagBytes",
            "aad",
            "plaintext"
          ]
        },
        "operations": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "required": [
              "id",
              "authorization",
              "effect"
            ]
          }
        }
      }
    },
    "ownerAndTenancy": {
      "type": "object",
      "required": [
        "initialMode",
        "principalTypes",
        "tenantIsolation",
        "ownerRights",
        "customerAdmission",
        "providerBudgets",
        "learningRights",
        "portability",
        "sharing"
      ]
    },
    "capabilitySystem": {
      "type": "object",
      "required": [
        "registry",
        "admissionStateMachine",
        "mcp",
        "hostTransport",
        "machineAdmission"
      ],
      "properties": {
        "admissionStateMachine": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "required": [
              "from",
              "event",
              "to",
              "guard"
            ]
          }
        },
        "mcp": {
          "type": "object",
          "required": [
            "protocol",
            "methods",
            "toolList",
            "calls",
            "result"
          ]
        }
      }
    },
    "skillAndScenarioSystem": {
      "type": "object",
      "required": [
        "bundledCatalog",
        "skillIdentity",
        "scenarioIdentity",
        "lifecycle",
        "learning",
        "promotion",
        "recovery",
        "privacy",
        "rights",
        "distribution",
        "learningAcceptance"
      ],
      "properties": {
        "distribution": {
          "type": "object",
          "required": [
            "decision",
            "ownerProfile",
            "security",
            "clientResource",
            "transactions",
            "commercial",
            "delivery",
            "lifecycle",
            "httpContract",
            "collections",
            "phases"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 10
          }
        },
        "learningAcceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scenarioId",
            "status",
            "outcome",
            "operationIds",
            "stages",
            "evidence",
            "refusals",
            "completion",
            "boundaries"
          ],
          "properties": {
            "scenarioId": {
              "type": "string",
              "const": "FCIS-LEARN-01"
            },
            "status": {
              "type": "string",
              "const": "SPECIFIED_ONLY"
            },
            "outcome": {
              "type": "string",
              "minLength": 20
            },
            "operationIds": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "stages": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "requirement"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]+$"
                  },
                  "requirement": {
                    "type": "string",
                    "minLength": 20
                  }
                }
              }
            },
            "evidence": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "requirement"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]+$"
                  },
                  "requirement": {
                    "type": "string",
                    "minLength": 20
                  }
                }
              }
            },
            "refusals": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "requirement"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]+$"
                  },
                  "requirement": {
                    "type": "string",
                    "minLength": 20
                  }
                }
              }
            },
            "completion": {
              "type": "string",
              "minLength": 20
            },
            "boundaries": {
              "type": "string",
              "minLength": 20
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "required": [
        "mode",
        "requiredForFreshInstall",
        "initiator",
        "preconditions",
        "steps",
        "rollback",
        "forbidden"
      ],
      "properties": {
        "mode": {
          "const": "OPTIONAL_ADOPT_EXISTING_ONLY"
        },
        "requiredForFreshInstall": {
          "const": false
        }
      }
    },
    "generation": {
      "type": "object",
      "required": [
        "stage",
        "buildHost",
        "primaryLanguage",
        "strategy",
        "requiredArtifacts",
        "completionSemantics",
        "testingPhase",
        "requirementCatalog",
        "requirementGate"
      ],
      "properties": {
        "primaryLanguage": {
          "const": "Go"
        },
        "requirementCatalog": {
          "type": "array",
          "minItems": 222,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "requirementGate": {
          "type": "object",
          "required": [
            "expectedRequirementCount",
            "method",
            "unmapped",
            "testsAllowedOnlyAfterGeneration",
            "minimumAtomicRequirementCount",
            "atomicCoverageClasses",
            "generatorReceipt"
          ],
          "properties": {
            "expectedRequirementCount": {
              "type": "integer",
              "minimum": 222
            },
            "unmapped": {
              "const": "INCOMPLETE"
            },
            "testsAllowedOnlyAfterGeneration": {
              "const": true
            },
            "minimumAtomicRequirementCount": {
              "type": "integer",
              "minimum": 222
            },
            "atomicCoverageClasses": {
              "type": "array",
              "minItems": 15,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "generatorReceipt": {
              "type": "object",
              "required": [
                "artifact",
                "initialStatus",
                "sourcePins",
                "requiredMappingFields",
                "accept",
                "refuse",
                "resumption",
                "completion"
              ],
              "properties": {
                "artifact": {
                  "const": "generation-coverage.json"
                },
                "initialStatus": {
                  "const": "INCOMPLETE"
                },
                "sourcePins": {
                  "type": "array",
                  "minItems": 5,
                  "items": {
                    "type": "string"
                  }
                },
                "requiredMappingFields": {
                  "type": "array",
                  "minItems": 7,
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "refuse": {
                  "type": "array",
                  "minItems": 7,
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    },
    "specificationClosure": {
      "type": "object",
      "required": [
        "namedGaps",
        "architectureDecision",
        "verificationStatus"
      ],
      "properties": {
        "namedGaps": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "id",
              "resolution",
              "source"
            ]
          }
        },
        "verificationStatus": {
          "type": "string",
          "minLength": 15
        }
      }
    },
    "knownSpecificationLimitations": {
      "type": "array",
      "maxItems": 0
    },
    "coverageBaseline": {
      "type": "object",
      "required": [
        "fcisHTTP",
        "fountainStoreHTTP",
        "secretStoreHTTP",
        "frontendFiles",
        "domains",
        "atomicRequirementCount",
        "atomicRequirementGroups"
      ],
      "properties": {
        "fcisHTTP": {
          "type": "integer",
          "minimum": 30
        },
        "fountainStoreHTTP": {
          "type": "integer",
          "minimum": 20
        },
        "secretStoreHTTP": {
          "type": "integer",
          "minimum": 4
        },
        "frontendFiles": {
          "type": "integer",
          "minimum": 8
        },
        "domains": {
          "type": "array",
          "minItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "atomicRequirementCount": {
          "type": "integer",
          "minimum": 222
        },
        "atomicRequirementGroups": {
          "type": "object",
          "minProperties": 15,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gitSource": {
      "type": "object",
      "required": [
        "repository",
        "ref",
        "path",
        "blobSha",
        "url"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^Fountain-Coach/[A-Za-z0-9._-]+$"
        },
        "ref": {
          "$ref": "#/$defs/sha"
        },
        "path": {
          "type": "string",
          "minLength": 4
        },
        "blobSha": {
          "$ref": "#/$defs/sha"
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/Fountain-Coach/"
        }
      }
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "name",
        "mandatory"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "mandatory": {
          "const": true
        },
        "sourcePointer": {
          "type": "string",
          "pattern": "^/"
        },
        "proofClass": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "httpApi": {
      "type": "object",
      "required": [
        "sourceId",
        "version",
        "operations"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "operations": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "method",
              "path",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "HEAD",
                  "OPTIONS"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "status": {
                "const": "specified"
              }
            }
          }
        }
      }
    }
  }
}
